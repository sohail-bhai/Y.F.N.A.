# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/civicai

# ── SMTP Email ────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=CivicAI Reporter <your_email@gmail.com>
COMPLAINT_RECIPIENT=civic.authority@municipality.gov.in

# ── App ───────────────────────────────────────────────────────────────────────
APP_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20
CONFIDENCE_THRESHOLD=0.60

# ── AI Model ──────────────────────────────────────────────────────────────────
# Options: "mock" | "local_torch" | "local_tf" | "yolo" | "api"
MODEL_BACKEND=mock
MODEL_PATH=                    # path to .pt / .h5 / .onnx file (for local backends)
MODEL_API_URL=                 # external inference endpoint URL (for "api" backend)
MODEL_API_KEY=                 # API key for external endpoint (optional)
